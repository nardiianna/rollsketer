{% doc %}
  @prompt
    una sezione completamente modificabile a livello di margini con a destra la possibilità di inderire il codice della cartina geografica presa da google maps (<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3094.5991628922407!2d11.767426712178466!3d45.77189057096009!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4778da153c100001%3A0xaedd489291ab910c!2sVia%20Bari%2C%203%2C%2036060%20Romano%20d&#39;Ezzelino%20VI!5e1!3m2!1sit!2sit!4v1781527248076!5m2!1sit!2sit" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>)
    
    a sinistra la possibilità di inserire un testo con titolo e sottotitolo, lo sfondo devo poter scegliere che colore mettere. per il fomato mobile metti i 2 slot uno sotto l'altro. prima il titolo con sottotitolo e poi cartina geografica
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-map-text-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-map-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
  }

  .ai-map-text-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
  }

  .ai-map-text-title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
  }

  .ai-map-text-subtitle-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
  }

  .ai-map-text-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-map-text-map-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.map_height }}px;
    border-radius: {{ block.settings.map_border_radius }}px;
    overflow: hidden;
  }

  .ai-map-text-map-wrapper-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ai-map-text-map-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-map-text-map-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-map-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-map-text-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-map-text-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
      padding-left: {{ block.settings.padding_left_mobile }}px;
      padding-right: {{ block.settings.padding_right_mobile }}px;
    }

    .ai-map-text-content-{{ ai_gen_id }} {
      order: 1;
    }

    .ai-map-text-map-wrapper-{{ ai_gen_id }} {
      order: 2;
    }
  }
{% endstyle %}

<div class="ai-map-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-map-text-container-{{ ai_gen_id }}">
    <div class="ai-map-text-content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-map-text-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.subtitle != blank %}
        <h3 class="ai-map-text-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</h3>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-map-text-description-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}
    </div>

    <div class="ai-map-text-map-wrapper-{{ ai_gen_id }}">
      {% if block.settings.map_embed_code != blank %}
        {{ block.settings.map_embed_code }}
      {% else %}
        <div class="ai-map-text-map-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-map-text-empty-state-{{ ai_gen_id }}">
            Aggiungi il codice embed di Google Maps
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

